FROM docker.io/library/node:lts-bookworm

LABEL org.opencontainers.image.title="sando node-ts runtime"
LABEL org.opencontainers.image.description="Local sando runtime template for Node.js and TypeScript projects"

ARG PNPM_VERSION=10.30.3
ARG SANDO_UID=10001
ARG SANDO_GID=10001

ENV CI=true \
	SHELL=/bin/bash \
	SANDO_TEMPLATE=node-ts \
	SANDO_WORKSPACE=/workspace \
	SANDO_ARTIFACTS=/artifacts \
	PNPM_HOME=/home/sando/.local/share/pnpm \
	PATH=/home/sando/.local/share/pnpm:$PATH

RUN apt-get update \
	&& apt-get install --no-install-recommends -y \
		bash \
		build-essential \
		ca-certificates \
		coreutils \
		curl \
		git \
		python3 \
		ripgrep \
		tar \
		xz-utils \
	&& rm -rf /var/lib/apt/lists/*

RUN npm install --global "pnpm@${PNPM_VERSION}" \
	&& npm cache clean --force \
	&& groupadd --gid "${SANDO_GID}" sando \
	&& useradd --create-home --shell /bin/bash --uid "${SANDO_UID}" --gid "${SANDO_GID}" sando \
	&& mkdir -p /workspace /artifacts /sando/runner \
	&& chown -R sando:sando /workspace /artifacts /sando /home/sando

COPY --chown=sando:sando rootfs/sando/runner/run.sh /sando/runner/run.sh

RUN chmod 0755 /sando/runner/run.sh

WORKDIR /workspace

USER sando

CMD ["/sando/runner/run.sh"]
