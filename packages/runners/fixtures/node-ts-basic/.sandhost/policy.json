{
	"version": 1,
	"defaultTemplate": "node-ts",
	"runtime": "podman",
	"defaultNetwork": "none",
	"allowedNetworks": ["none", "default"],
	"maxTtlSeconds": 900,
	"maxTimeoutSeconds": 120,
	"resources": {
		"cpu": 1,
		"memoryMb": 512
	},
	"secrets": {
		"allow": []
	},
	"artifacts": ["coverage/**", "test-results/**", "*.patch"],
	"exclude": [
		".git",
		"node_modules",
		".env",
		".env.*",
		"dist",
		"build",
		"coverage",
		".sandhost/runs",
		"ignored-dir"
	]
}
